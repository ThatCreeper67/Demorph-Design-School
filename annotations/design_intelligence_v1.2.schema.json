{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demorph.local/design-school/annotation/1.2.0",
  "title": "Evidence-linked design intelligence annotation",
  "version": "1.2.0",
  "description": "Additive reasoning record. Existing v1.0 and v1.1 annotations remain governed by their original schemas.",
  "type": "object",
  "required": ["schema_version", "annotation_id", "image", "brief_context", "analysis_metadata", "evidence", "observations", "relationships", "hierarchy", "evaluations", "recommendations", "specialists", "uncertainties", "curriculum_refs"],
  "properties": {
    "schema_version": {"const":"1.2.0"}, "annotation_id":{"type":"string"},
    "image":{"type":"object","required":["image_id","sha256","relative_path"],"properties":{"image_id":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"relative_path":{"type":"string"}},"additionalProperties":false},
    "brief_context":{"type":["string","null"]},
    "analysis_metadata":{"type":"object","required":["model","runtime","elapsed_ms","prompt_version","human_review"],"properties":{"model":{"type":"string"},"runtime":{"type":"string"},"elapsed_ms":{"type":"number","minimum":0},"prompt_version":{"type":"string"},"human_review":{"const":"unreviewed"}},"additionalProperties":false},
    "evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}},
    "observations":{"type":"array","items":{"type":"object","required":["observation_id","text","role","evidence_refs","confidence"],"properties":{"observation_id":{"type":"string"},"text":{"type":"string","minLength":1},"role":{"type":"string"},"evidence_refs":{"$ref":"#/$defs/nonEmptyRefs"},"confidence":{"$ref":"#/$defs/confidence"}},"additionalProperties":false}},
    "relationships":{"type":"array","items":{"type":"object","required":["relationship_id","subject_refs","relation","object_refs","effect","interpretation","principle","curriculum_refs","observation_refs","evidence_refs","confidence"],"properties":{"relationship_id":{"type":"string"},"subject_refs":{"$ref":"#/$defs/nonEmptyRefs"},"relation":{"type":"string"},"object_refs":{"$ref":"#/$defs/nonEmptyRefs"},"effect":{"type":"string"},"interpretation":{"type":"string"},"principle":{"type":["string","null"]},"curriculum_refs":{"$ref":"#/$defs/refs"},"observation_refs":{"$ref":"#/$defs/nonEmptyRefs"},"evidence_refs":{"$ref":"#/$defs/nonEmptyRefs"},"confidence":{"$ref":"#/$defs/confidence"}},"additionalProperties":false}},
    "hierarchy":{"type":"object","required":["apparent_order","reading_flow","intended_priority"],"properties":{"apparent_order":{"type":"array","items":{"type":"object","required":["observation_ref","rank","prominence_evidence","confidence"],"properties":{"observation_ref":{"type":"string"},"rank":{"type":"integer","minimum":1},"prominence_evidence":{"type":"string"},"confidence":{"$ref":"#/$defs/confidence"}},"additionalProperties":false}},"reading_flow":{"type":"array","items":{"type":"object","required":["sequence","rationale","confidence"],"properties":{"sequence":{"$ref":"#/$defs/nonEmptyRefs"},"rationale":{"type":"string"},"confidence":{"$ref":"#/$defs/confidence"}},"additionalProperties":false}},"intended_priority":{"type":"string"}},"additionalProperties":false},
    "evaluations":{"type":"array","items":{"type":"object","required":["evaluation_id","dimension","judgment","finding","impact","observation_refs","relationship_refs","evidence_refs","curriculum_refs","confidence","uncertainty"],"properties":{"evaluation_id":{"type":"string"},"dimension":{"type":"string"},"judgment":{"enum":["effective","mixed","weak","not_assessable"]},"finding":{"type":"string"},"impact":{"type":"string"},"observation_refs":{"$ref":"#/$defs/refs"},"relationship_refs":{"$ref":"#/$defs/refs"},"evidence_refs":{"$ref":"#/$defs/nonEmptyRefs"},"curriculum_refs":{"$ref":"#/$defs/refs"},"confidence":{"$ref":"#/$defs/confidence"},"uncertainty":{"enum":["low","medium","high","unknown"]}},"additionalProperties":false}},
    "recommendations":{"type":"array","items":{"type":"object","required":["recommendation_id","priority","change","reason","expected_impact","evaluation_refs","evidence_refs","confidence"],"properties":{"recommendation_id":{"type":"string"},"priority":{"enum":["critical","meaningful","optional","subjective"]},"change":{"type":"string"},"reason":{"type":"string"},"expected_impact":{"type":"string"},"evaluation_refs":{"$ref":"#/$defs/refs"},"evidence_refs":{"$ref":"#/$defs/nonEmptyRefs"},"confidence":{"$ref":"#/$defs/confidence"}},"additionalProperties":false}},
    "specialists":{"type":"array","items":{"type":"object","required":["area","finding","evidence_refs","relationship_refs","curriculum_refs","confidence"],"properties":{"area":{"type":"string"},"finding":{"type":"string"},"evidence_refs":{"$ref":"#/$defs/nonEmptyRefs"},"relationship_refs":{"$ref":"#/$defs/refs"},"curriculum_refs":{"$ref":"#/$defs/refs"},"confidence":{"$ref":"#/$defs/confidence"}},"additionalProperties":false}},
    "uncertainties":{"type":"array","items":{"type":"string"}},"curriculum_refs":{"$ref":"#/$defs/refs"}
  },
  "$defs":{"refs":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"nonEmptyRefs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"confidence":{"type":"number","minimum":0,"maximum":1},"evidence":{"type":"object","required":["evidence_id","description","location","confidence"],"properties":{"evidence_id":{"type":"string"},"description":{"type":"string","minLength":1},"location":{"type":"string"},"confidence":{"$ref":"#/$defs/confidence"}},"additionalProperties":false}},
  "additionalProperties":false
}
