{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demorph.local/design-school/annotation/1.1.0",
  "title": "Dynamic, poster-specific Design School annotation",
  "version": "1.1.0",
  "description": "Keeps a universal foundation and stores optional specialist analysis as extensible, evidence-linked module instances.",
  "type": "object",
  "required": ["schema_version","annotation_id","image","brief_context","foundation","analysis_plan","specialist_sections","source_prediction_ids","human_review","legacy_source_annotation"],
  "properties": {
    "schema_version":{"const":"1.1.0"},
    "annotation_id":{"type":"string","minLength":1},
    "image":{"$ref":"#/$defs/image"},
    "brief_context":{"type":["string","null"]},
    "foundation":{"$ref":"#/$defs/foundation"},
    "analysis_plan":{"$ref":"#/$defs/analysis_plan"},
    "specialist_sections":{"type":"array","items":{"$ref":"#/$defs/specialist_section"}},
    "source_prediction_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "human_review":{"$ref":"#/$defs/review"},
    "legacy_source_annotation":{"type":["object","null"]}
  },
  "$defs": {
    "uncertainty":{"enum":["low","medium","high","unknown","ambiguous","not_applicable"]},
    "source":{"enum":["direct_observation","model_inference","human_interpretation","brief_derived"]},
    "image":{"type":"object","required":["image_id","sha256","relative_path"],"properties":{"image_id":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"relative_path":{"type":"string"}},"additionalProperties":false},
    "claim":{"type":"object","required":["text","source","evidence_refs","confidence","uncertainty"],"properties":{"text":{"type":"string","minLength":1},"source":{"$ref":"#/$defs/source"},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}},"confidence":{"type":["number","null"],"minimum":0,"maximum":1},"uncertainty":{"$ref":"#/$defs/uncertainty"}},"additionalProperties":false},
    "evidence":{"type":"object","required":["evidence_id","text","source","source_ref","confidence","uncertainty"],"properties":{"evidence_id":{"type":"string"},"text":{"type":"string","minLength":1},"source":{"$ref":"#/$defs/source"},"source_ref":{"type":["string","null"]},"confidence":{"type":["number","null"],"minimum":0,"maximum":1},"uncertainty":{"$ref":"#/$defs/uncertainty"}},"additionalProperties":false},
    "normalized_box":{"type":["array","null"],"prefixItems":[{"type":"number","minimum":0,"maximum":1},{"type":"number","minimum":0,"maximum":1},{"type":"number","minimum":0,"maximum":1},{"type":"number","minimum":0,"maximum":1}],"minItems":4,"maxItems":4},
    "observe":{"type":"object","required":["visible_elements_locations","text_transcribed_with_confidence","uncertain_observations"],"properties":{"visible_elements_locations":{"type":"array","items":{"$ref":"#/$defs/claim"}},"text_transcribed_with_confidence":{"type":"array","items":{"$ref":"#/$defs/claim"}},"uncertain_observations":{"type":"array","items":{"$ref":"#/$defs/claim"}}},"additionalProperties":false},
    "component":{"type":"object","required":["component_id","component_type","significance","significance_rationale","bbox","functional_roles","visual_characteristics","spatial_relationship_ids","hierarchy_contribution","overall_contribution","strengths","weaknesses","possible_improvements"],"properties":{"component_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"},"component_type":{"type":"string","minLength":1},"significance":{"enum":["primary","supporting","grouped","background_context"]},"significance_rationale":{"$ref":"#/$defs/claim"},"bbox":{"$ref":"#/$defs/normalized_box"},"functional_roles":{"type":"array","items":{"$ref":"#/$defs/claim"}},"visual_characteristics":{"type":"array","items":{"$ref":"#/$defs/claim"}},"spatial_relationship_ids":{"type":"array","items":{"type":"string"}},"hierarchy_contribution":{"type":"array","items":{"$ref":"#/$defs/claim"}},"overall_contribution":{"type":"array","items":{"$ref":"#/$defs/claim"}},"strengths":{"type":"array","items":{"$ref":"#/$defs/claim"}},"weaknesses":{"type":"array","items":{"$ref":"#/$defs/claim"}},"possible_improvements":{"type":"array","items":{"$ref":"#/$defs/claim"}}},"additionalProperties":false},
    "relationship":{"type":"object","required":["relationship_id","subject_refs","relation","object_refs","effect","evidence_refs","source","uncertainty"],"properties":{"relationship_id":{"type":"string"},"subject_refs":{"type":"array","minItems":1,"items":{"type":"string"}},"relation":{"type":"string","minLength":1},"object_refs":{"type":"array","minItems":1,"items":{"type":"string"}},"effect":{"$ref":"#/$defs/claim"},"evidence_refs":{"type":"array","items":{"type":"string"}},"source":{"$ref":"#/$defs/source"},"uncertainty":{"$ref":"#/$defs/uncertainty"}},"additionalProperties":false},
    "group":{"type":"object","required":["group_id","name","component_refs","interaction_effect","evidence_refs"],"properties":{"group_id":{"type":"string","pattern":"^group_[A-Za-z0-9_.:-]+$"},"name":{"type":"string"},"component_refs":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string"}},"interaction_effect":{"$ref":"#/$defs/claim"},"evidence_refs":{"type":"array","items":{"type":"string"}}},"additionalProperties":false},
    "identify":{"type":"object","required":["components","component_groups","relationships"],"properties":{"components":{"type":"array","items":{"$ref":"#/$defs/component"}},"component_groups":{"type":"array","items":{"$ref":"#/$defs/group"}},"relationships":{"type":"array","items":{"$ref":"#/$defs/relationship"}}},"additionalProperties":false},
    "hierarchy_item":{"type":"object","required":["component_ref","level","order","rationale","evidence_refs","source","uncertainty"],"properties":{"component_ref":{"type":"string"},"level":{"enum":["primary","secondary","tertiary","utility","decorative","unknown"]},"order":{"type":["integer","null"],"minimum":1},"rationale":{"$ref":"#/$defs/claim"},"evidence_refs":{"type":"array","items":{"type":"string"}},"source":{"$ref":"#/$defs/source"},"uncertainty":{"$ref":"#/$defs/uncertainty"}},"additionalProperties":false},
    "hierarchy_composition":{"type":"object","required":["intended_hierarchy","apparent_hierarchy","attention_flow","spatial_relationships"],"properties":{"intended_hierarchy":{"type":"array","items":{"$ref":"#/$defs/hierarchy_item"}},"apparent_hierarchy":{"type":"array","items":{"$ref":"#/$defs/hierarchy_item"}},"attention_flow":{"type":"array","items":{"$ref":"#/$defs/claim"}},"spatial_relationships":{"type":"array","items":{"$ref":"#/$defs/relationship"}}},"additionalProperties":false},
    "component_assessment":{"type":"object","required":["component_ref","strengths","weaknesses","impact"],"properties":{"component_ref":{"type":"string"},"strengths":{"type":"array","items":{"$ref":"#/$defs/claim"}},"weaknesses":{"type":"array","items":{"$ref":"#/$defs/claim"}},"impact":{"type":"array","items":{"$ref":"#/$defs/claim"}}},"additionalProperties":false},
    "judge":{"type":"object","required":["component_assessments","overall_strengths","overall_weaknesses","impact_readability","impact_hierarchy","impact_communication","uncertainty_or_alternatives"],"properties":{"component_assessments":{"type":"array","items":{"$ref":"#/$defs/component_assessment"}},"overall_strengths":{"type":"array","items":{"$ref":"#/$defs/claim"}},"overall_weaknesses":{"type":"array","items":{"$ref":"#/$defs/claim"}},"impact_readability":{"type":"array","items":{"$ref":"#/$defs/claim"}},"impact_hierarchy":{"type":"array","items":{"$ref":"#/$defs/claim"}},"impact_communication":{"type":"array","items":{"$ref":"#/$defs/claim"}},"uncertainty_or_alternatives":{"type":"array","items":{"$ref":"#/$defs/claim"}}},"additionalProperties":false},
    "improvement":{"type":"object","required":["change","component_refs","group_refs","expected_impact","trade_offs","evidence_refs","source","uncertainty"],"properties":{"change":{"$ref":"#/$defs/claim"},"component_refs":{"type":"array","items":{"type":"string"}},"group_refs":{"type":"array","items":{"type":"string"}},"expected_impact":{"$ref":"#/$defs/claim"},"trade_offs":{"type":"array","items":{"$ref":"#/$defs/claim"}},"evidence_refs":{"type":"array","items":{"type":"string"}},"source":{"$ref":"#/$defs/source"},"uncertainty":{"$ref":"#/$defs/uncertainty"}},"additionalProperties":false},
    "foundation":{"type":"object","required":["observe","identify","hierarchy_composition","judge","improve"],"properties":{"observe":{"$ref":"#/$defs/observe"},"identify":{"$ref":"#/$defs/identify"},"hierarchy_composition":{"$ref":"#/$defs/hierarchy_composition"},"judge":{"$ref":"#/$defs/judge"},"improve":{"type":"array","items":{"$ref":"#/$defs/improvement"}}},"additionalProperties":false},
    "cue":{"type":"object","required":["signal","evidence_refs","confidence"],"properties":{"signal":{"type":"string"},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}},"confidence":{"type":"number","minimum":0,"maximum":1}},"additionalProperties":false},
    "module_decision":{"type":"object","required":["module_ref","heading","decision","rationale","evidence_refs","relevance_score"],"properties":{"module_ref":{"type":["string","null"]},"heading":{"type":"string"},"decision":{"enum":["selected","omitted"]},"rationale":{"type":"string","minLength":1},"evidence_refs":{"type":"array","items":{"type":"string"}},"relevance_score":{"type":"number","minimum":0}},"additionalProperties":false},
    "custom_proposal":{"type":"object","required":["proposal_id","heading","concept","rationale","focus_questions","evidence_refs","status","selection_decision"],"properties":{"proposal_id":{"type":"string"},"heading":{"type":"string"},"concept":{"type":"string"},"rationale":{"type":"string"},"focus_questions":{"type":"array","minItems":1,"items":{"type":"string"}},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}},"status":{"const":"proposed"},"selection_decision":{"enum":["selected","omitted_focus_budget"]}},"additionalProperties":false},
    "analysis_plan":{"type":"object","required":["module_catalog_version","planner_version","profile_source","evidence","cues","max_specialist_sections","module_decisions","custom_proposals"],"properties":{"module_catalog_version":{"type":"string"},"planner_version":{"type":"string"},"profile_source":{"$ref":"#/$defs/source"},"evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}},"cues":{"type":"array","items":{"$ref":"#/$defs/cue"}},"max_specialist_sections":{"type":"integer","minimum":0,"maximum":8},"module_decisions":{"type":"array","items":{"$ref":"#/$defs/module_decision"}},"custom_proposals":{"type":"array","items":{"$ref":"#/$defs/custom_proposal"}}},"additionalProperties":false},
    "specialist_subsection":{"type":"object","required":["subsection_id","heading","focus_questions","claims"],"properties":{"subsection_id":{"type":"string"},"heading":{"type":"string"},"focus_questions":{"type":"array","items":{"type":"string"}},"claims":{"type":"array","items":{"$ref":"#/$defs/claim"}}},"additionalProperties":false},
    "specialist_section":{"type":"object","required":["section_id","module_ref","proposal_ref","heading","scope","selection_rationale","evidence_refs","component_refs","group_refs","subsections"],"properties":{"section_id":{"type":"string"},"module_ref":{"type":["string","null"]},"proposal_ref":{"type":["string","null"]},"heading":{"type":"string"},"scope":{"enum":["catalogued_module","poster_specific"]},"selection_rationale":{"type":"string","minLength":1},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}},"component_refs":{"type":"array","items":{"type":"string"}},"group_refs":{"type":"array","items":{"type":"string"}},"subsections":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/specialist_subsection"}}},"additionalProperties":false},
    "correction":{"type":"object","required":["timestamp","field","old_value","new_value","reason"],"properties":{"timestamp":{"type":"string"},"field":{"type":"string"},"old_value":{},"new_value":{},"reason":{"type":"string"}},"additionalProperties":false},
    "review":{"type":"object","required":["reviewer_id_or_role","status","reviewed_version","reviewed_sections","reviewed_at","disagreement_status","correction_history"],"properties":{"reviewer_id_or_role":{"type":["string","null"]},"status":{"enum":["draft","in_review","approved","rejected"]},"reviewed_version":{"type":["string","null"]},"reviewed_sections":{"type":"array","items":{"type":"string"}},"reviewed_at":{"type":["string","null"],"format":"date-time"},"disagreement_status":{"enum":["none","open","adjudicated","not_reviewed"]},"correction_history":{"type":"array","items":{"$ref":"#/$defs/correction"}}},"additionalProperties":false}
  },
  "additionalProperties":false
}
