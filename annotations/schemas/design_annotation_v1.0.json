{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demorph.local/design-school/annotation/1.0.0",
  "title": "Design School human annotation",
  "version": "1.0.0",
  "type": "object",
  "required": ["schema_version", "image", "brief_context", "elements", "roles", "hierarchy", "principles", "evaluation", "critique", "human_review"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "image": {"$ref": "#/$defs/image"},
    "brief_context": {"type": ["string", "null"]},
    "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}},
    "roles": {"type": "array", "items": {"$ref": "#/$defs/role"}},
    "hierarchy": {"type": "array", "items": {"$ref": "#/$defs/hierarchy"}},
    "principles": {"type": "array", "items": {"$ref": "#/$defs/principle"}},
    "evaluation": {"type": "array", "items": {"$ref": "#/$defs/evaluation"}},
    "critique": {"$ref": "#/$defs/critique"},
    "human_review": {"$ref": "#/$defs/review"}
  },
  "$defs": {
    "image": {
      "type": "object", "required": ["image_id", "sha256", "relative_path"],
      "properties": {"image_id":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"relative_path":{"type":"string"}},
      "additionalProperties": false
    },
    "evidence": {
      "type":"object", "required":["evidence_id","source","description"],
      "properties": {
        "evidence_id":{"type":"string"},
        "source":{"enum":["direct_observation","model_inference","human_interpretation","brief_derived"]},
        "description":{"type":"string","minLength":1},
        "bbox":{"type":["array","null"],"prefixItems":[{"type":"number","minimum":0,"maximum":1},{"type":"number","minimum":0,"maximum":1},{"type":"number","minimum":0,"maximum":1},{"type":"number","minimum":0,"maximum":1}],"minItems":4,"maxItems":4},
        "uncertainty":{"enum":["low","medium","high","unknown","ambiguous","not_applicable"]}
      }, "additionalProperties":false
    },
    "element": {
      "type":"object", "required":["element_id","element_type","description","source","evidence","uncertainty"],
      "properties": {
        "element_id":{"type":"string"},"element_type":{"type":"string"},
        "bbox":{"type":["array","null"],"prefixItems":[{"type":"number","minimum":0,"maximum":1},{"type":"number","minimum":0,"maximum":1},{"type":"number","minimum":0,"maximum":1},{"type":"number","minimum":0,"maximum":1}],"minItems":4,"maxItems":4},
        "polygon":{"type":["array","null"],"items":{"type":"array","prefixItems":[{"type":"number","minimum":0,"maximum":1},{"type":"number","minimum":0,"maximum":1}],"minItems":2,"maxItems":2}},
        "description":{"type":"string"},"source":{"enum":["direct_observation","model_inference","human_interpretation"]},
        "evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}},
        "uncertainty":{"enum":["low","medium","high","unknown","ambiguous","not_applicable"]}
      }, "additionalProperties":false
    },
    "role": {
      "type":"object", "required":["element_id","primary_role","secondary_roles","source","evidence","uncertainty"],
      "properties": {
        "element_id":{"type":"string"},"primary_role":{"type":"string"},"secondary_roles":{"type":"array","items":{"type":"string"}},
        "source":{"enum":["model_inference","human_interpretation","brief_derived"]},"evidence":{"type":"array","items":{"type":"string"}},
        "uncertainty":{"enum":["low","medium","high","unknown","ambiguous","not_applicable"]}
      }, "additionalProperties":false
    },
    "hierarchy": {
      "type":"object", "required":["element_id","kind","level","priority","reading_order","rationale","evidence","uncertainty"],
      "properties": {
        "element_id":{"type":"string"},"kind":{"enum":["intended_priority","apparent_attention_prediction","measured_viewer_attention"]},
        "level":{"enum":["primary","secondary","tertiary","utility","decorative","unknown"]},"priority":{"type":["number","null"]},
        "reading_order":{"type":["integer","null"],"minimum":1},"rationale":{"type":"string"},"evidence":{"type":"array","items":{"type":"string"}},
        "uncertainty":{"enum":["low","medium","high","unknown","ambiguous","not_applicable"]}
      }, "additionalProperties":false
    },
    "principle": {
      "type":"object", "required":["principle","application","element_ids","evidence","source","uncertainty"],
      "properties": {
        "principle":{"type":"string"},"application":{"type":"string"},"element_ids":{"type":"array","items":{"type":"string"}},
        "evidence":{"type":"array","items":{"type":"string"}},"source":{"enum":["direct_observation","model_inference","human_interpretation"]},
        "uncertainty":{"enum":["low","medium","high","unknown","ambiguous","not_applicable"]}
      }, "additionalProperties":false
    },
    "evaluation": {
      "type":"object", "required":["dimension","score","judgement_kind","explanation","evidence","uncertainty"],
      "properties": {
        "dimension":{"enum":["communication_clarity","visual_hierarchy","typography_effectiveness","composition_effectiveness","colour_coherence","consistency","purpose_suitability"]},
        "score":{"type":["integer","null"],"minimum":1,"maximum":5},
        "judgement_kind":{"enum":["objective_measurement","brief_dependent_judgement","subjective_interpretation","unknown"]},
        "explanation":{"type":"string"},"evidence":{"type":"array","items":{"type":"string"}},
        "uncertainty":{"enum":["low","medium","high","unknown","ambiguous","not_applicable"]}
      }, "additionalProperties":false
    },
    "critique_item": {
      "type":"object", "required":["claim","element_ids","evidence","impact","judgement_kind","uncertainty"],
      "properties": {
        "claim":{"type":"string"},"element_ids":{"type":"array","items":{"type":"string"}},"evidence":{"type":"array","items":{"type":"string"}},
        "impact":{"enum":["low","medium","high","unknown"]},"judgement_kind":{"enum":["objective_measurement","brief_dependent_judgement","subjective_interpretation"]},
        "uncertainty":{"enum":["low","medium","high","unknown","ambiguous","not_applicable"]}
      }, "additionalProperties":false
    },
    "improvement": {
      "type":"object", "required":["change","element_ids","evidence","expected_impact","trade_offs","uncertainty"],
      "properties": {
        "change":{"type":"string"},"element_ids":{"type":"array","items":{"type":"string"}},"evidence":{"type":"array","items":{"type":"string"}},
        "expected_impact":{"type":"string"},"trade_offs":{"type":"array","items":{"type":"string"}},
        "uncertainty":{"enum":["low","medium","high","unknown","ambiguous","not_applicable"]}
      }, "additionalProperties":false
    },
    "critique": {
      "type":"object", "required":["strengths","weaknesses","improvements"],
      "properties": {
        "strengths":{"type":"array","items":{"$ref":"#/$defs/critique_item"}},
        "weaknesses":{"type":"array","items":{"$ref":"#/$defs/critique_item"}},
        "improvements":{"type":"array","items":{"$ref":"#/$defs/improvement"}}
      }, "additionalProperties":false
    },
    "review": {
      "type":"object", "required":["reviewer_id_or_role","status","annotation_version","reviewed_at","disagreement_status","correction_history"],
      "properties": {
        "reviewer_id_or_role":{"type":["string","null"]},
        "status":{"enum":["draft","in_review","approved","rejected"]},"annotation_version":{"type":"string"},
        "reviewed_at":{"type":["string","null"],"format":"date-time"},
        "disagreement_status":{"enum":["none","open","adjudicated","not_reviewed"]},
        "correction_history":{"type":"array","items":{"type":"object","required":["timestamp","field","old_value","new_value","reason"],"properties":{"timestamp":{"type":"string"},"field":{"type":"string"},"old_value":{},"new_value":{},"reason":{"type":"string"}},"additionalProperties":false}}
      }, "additionalProperties":false
    }
  },
  "additionalProperties": false
}
